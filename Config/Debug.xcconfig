#include "Version.xcconfig"

INFOPLIST_KEY_CFBundleDisplayName = MacPacker Debug

// ── Debug identity overrides ─────────────────────────────────────────────────
// Give Debug builds a distinct Launch Services / QuickLook / FinderSync identity
// so they no longer collide with an installed Release build. Defined here on the
// project-level Debug configuration, these cascade to every target's Debug config.
// Non-debug builds get the canonical values from the project-level Release /
// Release Store build settings (BUNDLE_ID_SUFFIX is simply empty there).
BUNDLE_ID_SUFFIX = .debug
APP_URL_SCHEME = app.macpacker.debug

// ── Debug code signing: "Sign to Run Locally" (ad-hoc) ───────────────────────
// No team, certificate, or provisioning profile required, so anyone can clone
// the repo and build/run the Debug build with zero configuration. Release and
// Release Store keep the maintainer's manual Developer ID / Apple Distribution
// signing (project Release configs + Release*.xcconfig) and are unaffected.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
PROVISIONING_PROFILE_SPECIFIER =

// App group that holds the engine settings, so the QuickLook extension reads
// the picks the app writes (each has its own sandbox container otherwise).
// Injected into the entitlements and into Info.plist as MPAppGroupIdentifier.
//
// Team-ID-prefixed, unlike the release configs' registered `group.app.macpacker`:
// a `group.`-prefixed app group is only authorised by a provisioning profile, so
// using it here would end this config's "clone and build, no signing setup" rule.
// The two never need to agree — a debug build has its own bundle ID and settings.
APP_GROUP_ID = ZJ2TSMMJWF.com.sarensx.MacPacker$(BUNDLE_ID_SUFFIX)

// Optional local override, last so it wins. Copy SigningOverride.xcconfig.template
// to SigningOverride.xcconfig to sign Debug builds with your own identity instead
// of ad-hoc; the file is gitignored, so everyone else keeps the zero-setup build.
#include? "SigningOverride.xcconfig"
