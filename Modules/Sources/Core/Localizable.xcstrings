    "%@ is password protected. Open it in MacPacker to enter the password." : {
      "comment" : "Error shown when an encrypted archive cannot request a password",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is password protected. Open it in MacPacker to enter the password."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ προστατεύεται με κωδικό. Ανοίξτε το στο MacPacker για να εισαγάγετε τον κωδικό."
