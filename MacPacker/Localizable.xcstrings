    "archiveContentViewerZipPasswordCharacterHint": {
      "comment": "Save options: the zip password has characters zip encryption cannot take",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Zip-Passwort darf nur Buchstaben (A–Z), Ziffern, Leerzeichen und gängige Symbole enthalten. 7z akzeptiert jedes beliebige Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A zip password can only use letters A–Z, digits, spaces and common symbols. 7z takes any password."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña de un archivo zip sólo puede contener letras A-Z, números, espacios y símbolos comunes. Los archivos 7z pueden tener cualquier contraseña."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "A zip password can only use letters A–Z, digits, spaces and common symbols. 7z takes any password."
          }
