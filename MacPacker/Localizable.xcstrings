    "settingsAutomaticEngineSelectionHint": {
      "comment": "Explains the automatic engine selection toggle in the archive format settings",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker wählt für jedes Archiv automatisch die passende Engine aus und versucht bei Bedarf eine andere, falls die erste das Archiv nicht lesen kann. Deaktiviere diese Option, um die Engine selbst auszuwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker chooses the engine for each archive, and tries another one if the first can't read it. Turn this off to choose engines yourself."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker chooses the engine for each archive, and tries another one if the first can't read it. Turn this off to choose engines yourself."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker chooses the engine for each archive, and tries another one if the first can't read it. Turn this off to choose engines yourself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker chooses the engine for each archive, and tries another one if the first can't read it. Turn this off to choose engines yourself."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker sceglie il motore per ogni archivio e ne prova un altro se il primo non riesce a leggerlo. Disattiva questa opzione per scegliere i motori manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker chooses the engine for each archive, and tries another one if the first can't read it. Turn this off to choose engines yourself."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker chooses the engine for each archive, and tries another one if the first can't read it. Turn this off to choose engines yourself."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker chooses the engine for each archive, and tries another one if the first can't read it. Turn this off to choose engines yourself."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker wybiera silnik dla każdego archiwum i próbuje innego, jeśli pierwszy nie może go odczytać. Wyłącz tę opcję, aby samodzielnie wybierać silniki."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker chooses the engine for each archive, and tries another one if the first can't read it. Turn this off to choose engines yourself."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker выбирает движок для каждого архива и пробует другой, если первый не может его прочитать. Отключите эту функцию, чтобы выбирать движки самостоятельно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker her arşiv için uygun altyapıyı seçer; ilk altyapı arşivi okuyamazsa başka birini dener. Altyapıları kendiniz seçmek için bu seçeneği kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker chooses the engine for each archive, and tries another one if the first can't read it. Turn this off to choose engines yourself."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker tự động chọn công cụ đọc/ghi cho mỗi tệp lưu trữ, và sẽ thử một công cụ khác nếu công cụ đầu tiên không thể đọc được. Hãy tắt tùy chọn này để tự chọn công cụ đọc/ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker 会为每个压缩包选择引擎，如果第一个无法读取，则会尝试另一个。关闭此选项可自行选择引擎。"
          }
        }
      }
    },
