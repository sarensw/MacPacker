    "settingsDefaultAppHint": {
      "comment": "Instructions in the alert explaining how to set MacPacker as the default app for archive files in Finder.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um MacPacker als Standard-App für einen Datei-Typen zu setzen: Rechts-klick auf eine Datei → 'Info Über' → MacPacker auswählen unter 'Öffnen mit:'→ 'Alle ändern'"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To make MacPacker the default for a file type: Right-click a file → 'Get Info' → choose MacPacker under 'Open with:' → click 'Change All…' to apply it to all similar archives."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para hacer que MacPacker sea la aplicación por defecto para un tipo de archivo en específico: Haz clic derecho en un archivo → 'Obtener Información' → selecciona MacPacker en el menu 'Abrir con:' → Haz clic en 'Cambiar todo…' para aplicar los cambios a todos los archivos del mismo tipo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "To make MacPacker the default for a file type: Right-click a file → 'Get Info' → choose MacPacker under 'Open with:' → click 'Change All…' to apply it to all similar archives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour définir MacPacker comme application par défaut pour un type de fichier : cliquez avec le bouton droit sur un fichier → “Lire les informations” → choisissez MacPacker sous “Ouvrir avec” → cliquez sur “Tout modifier…” pour l’appliquer à toutes les archives similaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per impostare MacPacker come predefinito per un tipo di file: fai clic destro sul file → “Ottieni informazioni” → scegli MacPacker sotto “Apri con:” → fai clic su “Modifica tutti…” per applicarlo a tutti gli archivi simili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "To make MacPacker the default for a file type: Right-click a file → 'Get Info' → choose MacPacker under 'Open with:' → click 'Change All…' to apply it to all similar archives."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "To make MacPacker the default for a file type: Right-click a file → 'Get Info' → choose MacPacker under 'Open with:' → click 'Change All…' to apply it to all similar archives."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "To make MacPacker the default for a file type: Right-click a file → 'Get Info' → choose MacPacker under 'Open with:' → click 'Change All…' to apply it to all similar archives."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby ustawić MacPacker domyślnie dla danego typu pliku: Kliknij plik prawym przyciskiem myszy → „Informacje” → wybierz MacPacker w sekcji „Otwórz za pomocą:” → kliknij „Zmień wszystko…”, aby zastosować tę opcję do wszystkich podobnych archiwów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "To make MacPacker the default for a file type: Right-click a file → 'Get Info' → choose MacPacker under 'Open with:' → click 'Change All…' to apply it to all similar archives."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы установить MacPacker в качестве программы по умолчанию для определенного типа файлов: щелкните правой кнопкой мыши файл → «Свойства» → выберите MacPacker в разделе «Открывать в приложении:» → нажмите «Настроить», чтобы применить это изменение ко всем похожим архивам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacPacker’ı bir dosya türü için varsayılan uygulama yapmak üzere dosyayı sağ tıklayın → ‘Bilgi Ver’i seçin → ‘Birlikte aç:’ bölümünde MacPacker’ı seçin → aynı türdeki tüm arşivlere uygulamak için ‘Tümünü Değiştir…’i tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб зробити MacPacker стандартним для певного типу файлів: клацніть правою кнопкою миші на файлі → «Досье» → виберіть MacPacker у розділі «Відкрити за допомогою:» → натисніть «Змінити все…», щоб застосувати його до всіх подібних архівів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đặt MacPacker làm trình mở mặc định cho một loại tệp: Nhấp chuột phải vào tệp → 'Get Info' → chọn MacPacker trong mục 'Open with' → nhấp vào 'Change All…' để áp dụng cho tất cả các tệp lưu trữ tương tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要将 MacPacker 设为某类文件的默认应用：右键点击文件 → “显示简介” → 在“打开方式”下选择 MacPacker → 点击“全部更改…”以应用于所有同类压缩包。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "To make MacPacker the default for a file type: Right-click a file → 'Get Info' → choose MacPacker under 'Open with:' → click 'Change All…' to apply it to all similar archives."
          }
        }
      }
    },
