    "appQuitDuringExtractionWarning": {
      "comment": "Body of the alert shown when the user quits while an extraction is running.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du jetzt beendest, wird die Entpackung abgebrochen. Am Zielort können unvollständige Dateien zurückbleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "es-mx": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir ahora detendrá la extracción y podría dejar archivos incompletos en el destino."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'uscita interrompe l'estrazione e può lasciare file incompleti nella destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończenie operacji rozpakowywania może spowodować niekompletność plików w miejscu docelowym."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход останавливает извлечение и может оставить неполные файлы в пункте назначения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi çıkarsanız çıkarma işlemi durdurulur ve hedefte tamamlanmamış dosyalar kalabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now stops the extraction and may leave incomplete files at the destination."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoát ngay bây giờ sẽ dừng quá trình giải nén và có thể để lại các tập tin chưa hoàn chỉnh tại thư mục đích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在退出将停止解压，并可能在目标位置留下不完整的文件。"
          }
        }
      }
    },
