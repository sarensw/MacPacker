        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot de passe zip ne contient que des lettres, des chiffres, des espaces et quelques symboles courants. 7z peut utiliser tous les mots de passe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
