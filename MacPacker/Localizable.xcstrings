{
  "sourceLanguage": "en",
  "strings": {
    "Archive operation in progress": {
      "comment": "Quit confirmation title while extracting or compressing",
      "extractionState": "manual"
    },
    "Archive progress": {
      "comment": "Accessibility title of the extraction and compression progress window",
      "extractionState": "manual"
    },
    "Cancel": {
      "comment": "Cancel extraction without changing the destination",
      "extractionState": "manual"
    },
    "Choose default formats…": {
      "comment": "Open the file association chooser",
      "extractionState": "manual"
    },
    "Choose the archive formats MacPacker should open. macOS may confirm each selected format. Numbered archive parts are not included.": {
      "comment": "Explanation above file association choices",
      "extractionState": "manual"
    },
    "Clear selection": {
      "comment": "Clear archive format checkboxes",
      "extractionState": "manual"
    },
    "Command-line interface": {
      "comment": "Advanced settings section title",
      "extractionState": "manual"
    },
    "Default archive app": {
      "comment": "Settings sheet title for file associations",
      "extractionState": "manual"
    },
    "Done": {
      "comment": "Close file association settings",
      "extractionState": "manual"
    },
    "Extract and compress without opening the main window. MacPacker quits when finished if it was launched only for this action.": {
      "comment": "Help below the Finder progress-only setting",
      "extractionState": "manual"
    },
    "Extraction destination already exists": {
      "comment": "Title when extracted items conflict with existing files",
      "extractionState": "manual"
    },
    "Extraction finished; replaced files were kept": {
      "comment": "Backup could not be moved to Trash after successful extraction",
      "extractionState": "manual"
    },
    "Finder actions": {
      "comment": "Settings: heading for Finder extraction and compression behavior",
      "extractionState": "manual"
    },
    "Keep Archives": {
      "comment": "Keep source archives after extraction",
      "extractionState": "manual"
    },
    "Make MacPacker default": {
      "comment": "Apply selected file associations",
      "extractionState": "manual"
    },
    "Merge": {
      "comment": "Merge extraction while keeping existing files",
      "extractionState": "manual"
    },
    "Merge keeps existing files and adds missing items. Replace All moves replaced items to Trash. New Folder extracts into a separate numbered folder.": {
      "comment": "Explanation of extraction conflict choices",
      "extractionState": "manual"
    },
    "Move archives to Trash after successful extraction": {
      "comment": "Optional removal of fully extracted source archives",
      "extractionState": "manual"
    },
    "Move extracted archives to Trash?": {
      "comment": "Confirm source cleanup for a public URL extraction request",
      "extractionState": "manual"
    },
    "Move to Trash": {
      "comment": "Confirm moving extracted source archives to Trash",
      "extractionState": "manual"
    },
    "New Folder": {
      "comment": "Extract to a separate uniquely named folder",
      "extractionState": "manual"
    },
    "No further default-app changes requested.": {
      "comment": "Association batch stopped after macOS did not confirm a change",
      "extractionState": "manual"
    },
    "OK": {
      "comment": "Dismiss extraction backup warning",
      "extractionState": "manual"
    },
    "Only after extracting the whole archive. Failed or cancelled extractions keep the original.": {
      "comment": "Explanation of safe source archive removal",
      "extractionState": "manual"
    },
    "Quitting now will interrupt extraction or compression. Do you want to quit anyway?": {
      "comment": "Quit confirmation while an archive operation is running",
      "extractionState": "manual"
    },
    "Replace All": {
      "comment": "Replace conflicting extraction destinations with recoverable backups",
      "extractionState": "manual"
    },
    "Select all": {
      "comment": "Select all archive format checkboxes",
      "extractionState": "manual"
    },
    "Selected archive associations updated.": {
      "comment": "File association success message",
      "extractionState": "manual"
    },
    "Show only progress for Finder actions": {
      "comment": "Settings checkbox: extract and compress from Finder without opening the main app window",
      "extractionState": "manual"
    },
    "Stop": {
      "comment": "Stop requesting further default archive associations",
      "extractionState": "manual"
    },
    "The backup could not be moved to Trash. Your original files are still available here:": {
      "comment": "Followed by recovery backup folder path",
      "extractionState": "manual"
    },
    "Use this command in Terminal to see available archive commands:": {
      "comment": "Instructions for bundled CLI",
      "extractionState": "manual"
    },
    "appExtractionInProgress": {
      "comment": "Title of the alert shown when the user quits while an extraction is running.",
