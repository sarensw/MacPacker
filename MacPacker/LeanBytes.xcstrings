    "sponsoringInfo" : {
      "comment" : "Explains that supporting the listed LeanBytes apps supports MacPacker",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacPacker wird durch meine eigene Arbeit bei LeanBytes finanziert. Wenn du die Apps unten unterstützt, unterstützt du direkt dieses Open-Source-Tool."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacPacker is sponsored by my own work at LeanBytes. Supporting the apps below directly supports this open-source tool."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacPacker se financia con mi propio trabajo en LeanBytes. Al apoyar las apps de abajo, apoyas directamente esta herramienta de código abierto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هزینه‌های MacPacker از کار خودم در LeanBytes تأمین می‌شود. حمایت از برنامه‌های زیر، مستقیماً از این ابزار متن‌باز حمایت می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacPacker est financé par mon propre travail chez LeanBytes. Soutenir les apps ci-dessous, c’est soutenir directement cet outil open source."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacPacker è finanziato dal mio lavoro in LeanBytes. Sostenere le app qui sotto significa sostenere direttamente questo strumento open source."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
