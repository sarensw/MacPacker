{
  "sourceLanguage" : "en",
  "strings" : {
    "fileFillet" : {
      "comment" : "Description of the FileFillet app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiere oder verschiebe Dateien in deine Lieblingsordner und deren Unterordner. Ganz ohne neue Finder-Fenster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy or move files to your favorite folders and their sub-folders. No need to open new Finder windows."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia o mueve archivos a tus carpetas favoritas y sus subcarpetas. Sin abrir nuevas ventanas del Finder."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فایل‌ها را به پوشه‌های دلخواه‌تان و زیرپوشه‌های آن‌ها کپی یا منتقل کنید. بدون نیاز به باز کردن پنجره‌های جدید Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez ou déplacez des fichiers vers vos dossiers favoris et leurs sous-dossiers. Sans ouvrir de nouvelles fenêtres Finder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia o sposta i file nelle tue cartelle preferite e nelle loro sottocartelle. Senza aprire nuove finestre del Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく使うフォルダとそのサブフォルダへファイルをコピー・移動。新しいFinderウインドウを開く必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾는 폴더와 그 하위 폴더로 파일을 복사하거나 이동하세요. 새 Finder 윈도우를 열 필요가 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieer of verplaats bestanden naar je favoriete mappen en hun submappen. Zonder nieuwe Finder-vensters te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiuj lub przenoś pliki do ulubionych folderów i ich podfolderów. Bez otwierania nowych okien Findera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie ou mova arquivos para suas pastas favoritas e respectivas subpastas. Sem abrir novas janelas do Finder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копируйте или перемещайте файлы в избранные папки и их подпапки. Без открытия новых окон Finder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaları favori klasörlerinize ve alt klasörlerine kopyalayın veya taşıyın. Yeni Finder pencereleri açmanıza gerek yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копіюйте або переміщуйте файли до улюблених папок та їхніх підпапок. Без відкриття нових вікон Finder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sao chép hoặc di chuyển tệp vào các thư mục ưa thích và thư mục con của chúng. Không cần mở cửa sổ Finder mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将文件拷贝或移动到常用文件夹及其子文件夹，无需打开新的“访达”窗口。"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντιγράψτε ή μετακινήστε αρχεία στους αγαπημένους σας φακέλους και στους υποφακέλους τους, χωρίς να ανοίγετε νέα παράθυρα του Finder."
          }
        }
      }
    },
